generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FREELANCER
  ADMIN
}

enum QuestionType {
  MCQ
  CODING
  PRACTICAL
}

enum TestStatus {
  PASSED
  FAILED
  PENDING
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  password       String          // Added for authentication
  role           Role            @default(FREELANCER)
  createdAt      DateTime        @default(now())
  
  testAttempts   TestAttempt[]
  certifications Certification[]
  badges         Badge[]
}

model Skill {
  id          String     @id @default(uuid())
  name        String     @unique
  questions   Question[]
  exams       Exam[]
}

model Question {
  id             String       @id @default(uuid())
  text           String
  type           QuestionType
  skillId        String
  skill          Skill        @relation(fields: [skillId], references: [id])
  options        Json?        // Stores MCQ options like ["A", "B", "C", "D"]
  correctAnswer  String       // The correct option or regex for evaluation
  points         Int          @default(1)
  
  examQuestions  ExamQuestion[]
  submissions    Submission[]
}

model Exam {
  id           String         @id @default(uuid())
  title        String
  description  String?
  skillId      String
  skill        Skill          @relation(fields: [skillId], references: [id])
  duration     Int            // In minutes
  passingScore Int            // Minimum points to pass
  
  questions    ExamQuestion[]
  attempts     TestAttempt[]
}

model ExamQuestion {
  examId       String
  questionId   String

  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
}

model TestAttempt {
  id           String       @id @default(uuid())
  userId       String
  examId       String
  score        Int          @default(0)
  status       TestStatus   @default(PENDING)
  attemptDate  DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions  Submission[]
}

model Submission {
  id             String      @id @default(uuid())
  attemptId      String
  questionId     String
  givenAnswer    String
  isCorrect      Boolean     @default(false)
  scoreAutomated Int         @default(0)

  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Certification {
  id             String    @id @default(uuid())
  userId         String
  examId         String
  certificateUrl String
  issueDate      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(uuid())
  userId    String
  name      String
  criteria  String
  issueDate DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
