generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EC_Role {
  FREELANCER
  ADMIN
}

enum EC_QuestionType {
  MCQ
  CODING
  PRACTICAL
}

enum EC_TestStatus {
  PASSED
  FAILED
  PENDING
}

model EC_User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String
  password       String
  role           EC_Role         @default(FREELANCER)
  createdAt      DateTime        @default(now())
  
  testAttempts   EC_TestAttempt[]
  certifications EC_Certification[]
  badges         EC_Badge[]
}

model EC_Skill {
  id          String        @id @default(uuid())
  name        String        @unique
  questions   EC_Question[]
  exams       EC_Exam[]
}

model EC_Question {
  id             String          @id @default(uuid())
  text           String
  type           EC_QuestionType
  skillId        String
  skill          EC_Skill        @relation(fields: [skillId], references: [id])
  options        Json?
  correctAnswer  String
  points         Int             @default(1)
  
  examQuestions  EC_ExamQuestion[]
  submissions    EC_Submission[]
}

model EC_Exam {
  id           String           @id @default(uuid())
  title        String
  description  String?
  skillId      String
  skill        EC_Skill         @relation(fields: [skillId], references: [id])
  duration     Int
  passingScore Int
  
  questions    EC_ExamQuestion[]
  attempts     EC_TestAttempt[]
  certifications EC_Certification[]
}

model EC_ExamQuestion {
  examId       String
  questionId   String

  exam         EC_Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question     EC_Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
}

model EC_TestAttempt {
  id           String          @id @default(uuid())
  userId       String
  examId       String
  score        Int             @default(0)
  status       EC_TestStatus   @default(PENDING)
  attemptDate  DateTime        @default(now())
  completedAt  DateTime?

  user         EC_User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         EC_Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions  EC_Submission[]
}

model EC_Submission {
  id             String         @id @default(uuid())
  attemptId      String
  questionId     String
  givenAnswer    String
  isCorrect      Boolean        @default(false)
  scoreAutomated Int            @default(0)

  attempt        EC_TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       EC_Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model EC_Certification {
  id             String    @id @default(uuid())
  userId         String
  examId         String
  certificateUrl String
  issueDate      DateTime  @default(now())

  user           EC_User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           EC_Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model EC_Badge {
  id        String   @id @default(uuid())
  userId    String
  name      String
  criteria  String
  issueDate DateTime @default(now())

  user      EC_User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
